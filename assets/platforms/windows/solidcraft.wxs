<?xml version="1.0" encoding="utf-8"?>
<!--
  SolidCraft MSI (WiX Toolset v5, plus the UI and Util extensions). Built by package.ps1:

    wix build solidcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc solidcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -o out.msi

  A setup wizard: Welcome, who to install for (all users, the default, or just me), install folder
  (Program Files\SolidCraft, or %LocalAppData%\Programs\SolidCraft just for me; an update keeps
  the installed scope and folder and skips both pages), Ready, progress, and a Finish page with a
  ticked "Launch SolidCraft" box. Installs a Start Menu shortcut, solidcraft-cli (and adds its folder to the system PATH), the licence files (including
  THIRD-PARTY-LICENSES.txt), makes SolidCraft the owner of `.sc` (and of the older `.solidcraft`) and of `solidcraft://` links, and offers it under
  "Open with" for STEP, IGES, 3MF and STL. `msiexec /qn` installs silently.

  Install scope (docs/book/src/guide/getting-started.md, "Installing on Windows"). The package is
  per-machine exactly as before unless asked otherwise: ALLUSERS=1, and the Word Count summary
  keeps elevation, so `msiexec /i solidcraft.msi /qn` and an update behave as they always have.
  "Just for me" is Windows Installer's per-user context: `ALLUSERS=2 MSIINSTALLPERUSER=1` on the
  command line, or the choice in the wizard. Then the folder is %LocalAppData%\Programs\SolidCraft,
  HKMU registry values and the file types go to HKCU, the Start menu shortcut to the user's own
  Start menu, solidcraft-cli to the user's PATH, and no administrator is needed. A per-user
  install is updated in its own context (the wizard finds it, the in-app updater passes the two
  properties); Windows keeps the two contexts apart, so a per-user and a per-machine install
  can live side by side, each updated on its own.
  Adapted from PhotoCraft's (storytold/photocraft, Apache-2.0; see ATTRIBUTION.md).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- This install is per-user ("just for me"). Windows Installer clears ALLUSERS for a per-user
       install, or leaves ALLUSERS=2 with MSIINSTALLPERUSER=1; both mean the user's own context. -->
  <?define PerUser = (NOT ALLUSERS OR (ALLUSERS=2 AND MSIINSTALLPERUSER=1)) ?>
  <!-- Never change the UpgradeCode: it is what lets a new MSI replace every earlier install,
       including those from before the product was renamed (docs/compatibility.md). -->
  <Package
      Name="SolidCraft"
      Manufacturer="SolidCraft contributors"
      Version="$(var.Version)"
      UpgradeCode="6A145FD6-D285-428D-AE84-A69570CDF4DB"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="SolidCraft parametric 3D CAD" Manufacturer="SolidCraft contributors" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other.
         The new version is installed first and the old one removed afterwards
         (afterInstallExecute), so solidcraft.exe and the Start menu shortcut stay at their path
         through an update: removing them first made Windows drop a Start menu or taskbar pin on
         every update (#9366). This relies on the component rules: a component keeps its GUID and
         its files keep their names and folder; a file that moves or is renamed gets a new
         component. The Start menu shortcut is part of the SolidcraftApp component and is not
         advertised, so removing the old product leaves it in place (see StartMenuShortcut for the
         one upgrade path that still loses it). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute"
        DowngradeErrorMessage="A newer version of SolidCraft is already installed." />
    <!-- With the old files still in place during the install, the default rules ("o": replace
         only an older file version) would keep the old solidcraft.exe of a pre-release or nightly
         of the same X.Y.Z, whose file version is the same. "a" replaces every file; all of them
         are SolidCraft's own. -->
    <Property Id="REINSTALLMODE" Value="amus" />
    <!-- Never restart the computer at the end of an install or update, whoever starts it: the
         in-app updater of an older SolidCraft runs `msiexec /passive` without REBOOT, and Windows
         then restarted the PC by itself when a file was in use (#18774). A file that is in use is
         replaced at the next restart instead. -->
    <Property Id="REBOOT" Value="ReallySuppress" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- This MSI icon is only for Programs and Features. A shortcut must use the installed
         executable's embedded icon instead: Windows caches an MSI Icon-table image under the
         ProductCode, then removes that old path on upgrade (#9366). -->
    <Icon Id="SolidcraftIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="SolidcraftIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://docs.solidcraft.io/" />
    <Property Id="ARPURLUPDATEINFO" Value="https://github.com/bherbruck/solidcraft/releases" />
    <Property Id="ARPHELPLINK" Value="https://github.com/bherbruck/solidcraft/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="SolidCraft" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by SolidcraftApp,
         under HKLM for all users and HKCU just for me). Each context reads only its own record. -->
    <!-- A pre-rename install recorded a different key, which isn't read: its upgrade (same
         UpgradeCode) removes the old folder and installs into Program Files\SolidCraft
         (docs/compatibility.md). -->
    <Property Id="SOLIDCRAFTMACHINEDIR">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\SolidCraft" Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="SOLIDCRAFTUSERDIR">
      <RegistrySearch Id="PreviousUserInstallFolder" Root="HKCU" Key="Software\SolidCraft" Name="InstallDir" Type="raw" />
    </Property>
    <!-- After the wizard's own scope actions below (InstallUISequence), before costing. -->
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderMachine" Value="[SOLIDCRAFTMACHINEDIR]" Before="CostInitialize" Sequence="both"
        Condition="SOLIDCRAFTMACHINEDIR AND NOT $(var.PerUser)" />
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderUser" Value="[SOLIDCRAFTUSERDIR]" After="SetInstallFolderMachine" Sequence="both"
        Condition="SOLIDCRAFTUSERDIR AND $(var.PerUser)" />
    <!-- Just for me, a first install: the user's own programs folder (FOLDERID_UserProgramFiles). -->
    <SetProperty Id="INSTALLFOLDER" Action="SetInstallFolderUserDefault" Value="[LocalAppDataFolder]Programs\SolidCraft\" After="SetInstallFolderUser" Sequence="both"
        Condition="NOT INSTALLFOLDER AND $(var.PerUser)" />

    <!-- The wizard (full UI only; `/qn` and `/passive` skip it and take the command line as it is).
         A scope given on the command line is kept and its page skipped. -->
    <SetProperty Id="SolidcraftScopeFixed" Value="1" After="AppSearch" Sequence="ui"
        Condition="MSIINSTALLPERUSER=1 OR NOT ALLUSERS" />
    <!-- Only a per-user SolidCraft is installed: update it there, as a per-machine one is. The
         wizard started in the per-machine context, so it didn't find it as an upgrade. -->
    <SetProperty Id="SolidcraftUserUpgrade" Value="1" After="SolidcraftScopeFixed" Sequence="ui"
        Condition="SOLIDCRAFTUSERDIR AND NOT SOLIDCRAFTMACHINEDIR AND NOT WIX_UPGRADE_DETECTED AND NOT SolidcraftScopeFixed" />
    <SetProperty Id="ALLUSERS" Action="SetPerUserUpgradeAllUsers" Value="2" After="SolidcraftUserUpgrade" Sequence="ui"
        Condition="SolidcraftUserUpgrade" />
    <SetProperty Id="MSIINSTALLPERUSER" Action="SetPerUserUpgradeInstall" Value="1" After="SetPerUserUpgradeAllUsers" Sequence="ui"
        Condition="SolidcraftUserUpgrade" />
    <!-- The two folders the scope page switches between; an earlier install's folder in each. -->
    <SetProperty Id="SolidcraftMachineFolder" Value="[INSTALLFOLDER]" After="CostFinalize" Sequence="ui" Condition="NOT $(var.PerUser)" />
    <SetProperty Id="SolidcraftUserFolder" Value="[LocalAppDataFolder]Programs\SolidCraft\" After="SolidcraftMachineFolder" Sequence="ui" />
    <Property Id="SolidcraftScope" Value="machine" />

    <Feature Id="Main" Title="SolidCraft" Level="1">
      <ComponentGroupRef Id="SolidcraftFiles" />
    </Feature>

    <!-- WixUI_InstallDir without its licence page (MIT OR Apache-2.0: nothing to accept). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <DialogRef Id="SolidcraftScopeDlg" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="SolidcraftScopeDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3" Condition="NOT Installed AND SolidcraftScopeFixed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="SolidcraftScopeDlg" Order="2" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="SolidcraftScopeFixed" />
      <!-- An update keeps the scope and folder of the installed version: the components keep their
           GUIDs (see MajorUpgrade), so they must not move to another folder. -->
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="4" Condition="NOT Installed AND (WIX_UPGRADE_DETECTED OR SolidcraftUserUpgrade)" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="3" Condition="NOT Installed AND (WIX_UPGRADE_DETECTED OR SolidcraftUserUpgrade)" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchSolidcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="SolidcraftVersion" Value="$(var.DisplayVersion)" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="SolidCraft $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch SolidCraft" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#SolidcraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user. -->
    <CustomAction Id="LaunchSolidcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <!-- Who to install for. All users stays the default: the same per-machine install as always. -->
  <Fragment>
    <UI>
      <TextStyle Id="WixUI_Font_Emphasized" FaceName="Tahoma" Size="8" Bold="yes" />
      <Dialog Id="SolidcraftScopeDlg" Width="370" Height="270" Title="!(loc.InstallScopeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallScopeDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.SolidcraftScopeDlgTitle)" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="!(loc.SolidcraftScopeDlgDescription)" />
        <Control Id="Scope" Type="RadioButtonGroup" X="20" Y="55" Width="330" Height="130" Property="SolidcraftScope">
          <RadioButtonGroup Property="SolidcraftScope">
            <RadioButton Value="machine" X="0" Y="0" Width="320" Height="16" Text="!(loc.SolidcraftScopeDlgPerMachine)" />
            <RadioButton Value="user" X="0" Y="62" Width="320" Height="16" Text="!(loc.SolidcraftScopeDlgPerUser)" />
          </RadioButtonGroup>
        </Control>
        <Control Id="PerMachineDescription" Type="Text" X="37" Y="73" Width="310" Height="40" NoPrefix="yes" Text="!(loc.SolidcraftScopeDlgPerMachineDescription)" />
        <Control Id="PerUserDescription" Type="Text" X="37" Y="135" Width="310" Height="40" NoPrefix="yes" Text="!(loc.SolidcraftScopeDlgPerUserDescription)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="WelcomeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Property="ALLUSERS" Value="1" Order="1" Condition="SolidcraftScope = &quot;machine&quot;" />
          <Publish Property="MSIINSTALLPERUSER" Value="{}" Order="2" Condition="SolidcraftScope = &quot;machine&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[SolidcraftMachineFolder]" Order="3" Condition="SolidcraftScope = &quot;machine&quot; AND SolidcraftMachineFolder" />
          <Publish Property="ALLUSERS" Value="2" Order="4" Condition="SolidcraftScope = &quot;user&quot;" />
          <Publish Property="MSIINSTALLPERUSER" Value="1" Order="5" Condition="SolidcraftScope = &quot;user&quot;" />
          <Publish Property="INSTALLFOLDER" Value="[SolidcraftUserFolder]" Order="6" Condition="SolidcraftScope = &quot;user&quot;" />
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="7" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="SolidcraftFiles" Directory="INSTALLFOLDER">
      <!-- A new GUID with the rename: the key file changed name. The UpgradeCode above is
           unchanged, so this MSI major-upgrades a pre-rename install. -->
      <Component Id="SolidcraftApp" Guid="A379D509-D776-4B34-A3A4-71FBF5724971">
        <File Id="SolidcraftExe" Source="$(var.BinDir)\solidcraft.exe" KeyPath="yes">
          <!-- The shortcut is "SolidCraft.lnk" again. Releases 0.30.1 and earlier advertised their
               shortcut, and an advertised shortcut is removed with its feature, by file name: when
               the old product is removed after this one is installed (afterInstallExecute), its
               ShortcutRemove deletes "SolidCraft.lnk" and nothing recreates it. So upgrading
               straight from 0.30.1 or older can leave no Start menu entry until the user reinstalls
               or repairs. We accept that: those releases are many versions old. Later releases
               write a non-advertised shortcut of this name, which the old removal does not touch,
               and an update keeps it in place. 0.42 shipped it as "SolidCraft CAD"; the RemoveFile
               below deletes that leftover so an install or upgrade does not leave two entries. -->
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="SolidCraft"
              Description="SolidCraft parametric 3D CAD" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        </File>
        <RemoveFile Id="RemoveStartMenuShortcutCad" Directory="ProgramMenuFolder" Name="SolidCraft CAD.lnk" On="both" />

        <!-- .sc: SolidCraft's own format; SolidCraft is its default app. -->
        <ProgId Id="Solidcraft.Design" Description="SolidCraft Design" Icon="SolidcraftExe" IconIndex="0">
          <Extension Id="sc" ContentType="application/x-solidcraft">
            <Verb Id="open" Command="Open" TargetFile="SolidcraftExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- Compatibility shim (docs/compatibility.md): designs saved as .solidcraft (before .sc)
             open as the same ProgId. Registered by hand: a
             second Extension under one ProgId would write its open verb twice (WIX0091). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\.solidcraft" Value="Solidcraft.Design" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.solidcraft" Name="Content Type" Value="application/x-solidcraft" Type="string" />
        <!-- STEP, IGES and meshes: offered under "Open with", never forced as the default. -->
        <ProgId Id="Solidcraft.Model" Description="3D model" Icon="SolidcraftExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Solidcraft.Model\shell\open\command" Value="&quot;[#SolidcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.step\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.stp\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.igs\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.iges\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.3mf\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.stl\OpenWithProgids" Name="Solidcraft.Model" Value="" Type="string" />

        <!-- solidcraft:// links (a Workshop page's Open in SolidCraft button, docs/workshop-links.md):
             the browser starts the app with the link as its open-url argument. The app looks the item up
             in the signed Workshop index and asks before it opens or installs anything. -->
        <RegistryValue Root="HKMU" Key="Software\Classes\solidcraft" Value="URL:SolidCraft" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\solidcraft" Name="URL Protocol" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\solidcraft\DefaultIcon" Value="&quot;[#SolidcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\solidcraft\shell\open\command" Value="&quot;[#SolidcraftExe]&quot; --open-url &quot;%1&quot;" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "solidcraft"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe" Name="FriendlyAppName" Value="SolidCraft" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\shell\open\command" Value="&quot;[#SolidcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".sc" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".solidcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".step" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".stp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".igs" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".iges" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".3mf" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\solidcraft.exe\SupportedTypes" Name=".stl" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\solidcraft.exe" Value="[#SolidcraftExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\SolidCraft" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="SolidcraftCli">
        <File Id="SolidcraftCliExe" Source="$(var.BinDir)\solidcraft-cli.exe" KeyPath="yes" />
      </Component>
      <!-- The install folder on the PATH, so MCP clients and shells find `solidcraft-cli` by name;
           removed again on uninstall. The system PATH for all users, the user's own PATH just for
           me (writing the system one needs an administrator). -->
      <Component Id="SolidcraftPathMachine" Guid="6F0F3B0E-2D8B-4C47-9C3E-8B1B6E0B6A11" Condition="NOT $(var.PerUser)">
        <RegistryValue Root="HKMU" Key="Software\SolidCraft" Name="CliOnPath" Value="system" Type="string" KeyPath="yes" />
        <Environment Id="SolidcraftPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="yes" Permanent="no" />
      </Component>
      <Component Id="SolidcraftPathUser" Guid="0C5B8E43-7A1D-4F06-B2E9-3D5A9C4F7E28" Condition="$(var.PerUser)">
        <RegistryValue Root="HKMU" Key="Software\SolidCraft" Name="CliOnPath" Value="user" Type="string" KeyPath="yes" />
        <Environment Id="SolidcraftUserPath" Name="PATH" Value="[INSTALLFOLDER]" Action="set" Part="last" System="no" Permanent="no" />
      </Component>
      <!-- Several unversioned files: an explicit GUID (WIX0367). -->
      <Component Id="SolidcraftLicences" Guid="CDEDEE8D-4BE9-4872-A2EA-EE623A6C7E91">
        <File Id="LicenseMit" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
        <File Id="LicenseApache" Source="$(var.BinDir)\LICENSE-APACHE" />
        <File Id="Notice" Source="$(var.BinDir)\NOTICE" />
        <File Id="ThirdParty" Source="$(var.BinDir)\THIRD-PARTY-LICENSES.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
